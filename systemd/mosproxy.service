[Unit]
Description=mosproxy DNS 转发服务(DoH/DoT 公网入口)
After=network.target unbound.service
Wants=unbound.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/bin/bash -o pipefail -c '/opt/dns-stack/bin/mosproxy router -c /etc/dns-stack/mosproxy/config.yaml 2>&1 | /opt/dns-stack/bin/dns-stack-go collect consume-stdin'
Environment=MOSPROXY_JSONLOGGER=true
Restart=always
RestartSec=3
LimitNOFILE=1048576
User=root
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ProtectSystem=strict
ReadWritePaths=/var/lib/dns-stack
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
