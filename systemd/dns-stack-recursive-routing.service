[Unit]
Description=dns-stack 递归出口按目标 IP 分流
After=wg-quick@wg0.service
Wants=wg-quick@wg0.service
PartOf=wg-quick@wg0.service
After=nftables.service

PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/dns-stack/bin/dns-stack-go routing-setup apply

ExecStartPost=-/usr/sbin/unbound-control -c /etc/unbound/unbound.conf flush_infra all

ExecStop=/opt/dns-stack/bin/dns-stack-go routing-setup revert

[Install]
WantedBy=multi-user.target
