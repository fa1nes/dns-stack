[Unit]
Description=dns-stack 生成共享 anycast 权威清单(多租户 DNS provider)
Documentation=file:///opt/dns-stack/dns-stack/internal/anycast/anycast.go
After=dns-stack-chnroute.service dns-stack-geoip.service unbound.service
Wants=unbound.service

[Service]
Type=oneshot
ExecStart=/opt/dns-stack/bin/dns-stack-go shared-anycast
Nice=10
IOSchedulingClass=idle

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/dns-stack

[Install]
WantedBy=multi-user.target
