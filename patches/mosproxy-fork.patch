diff --git a/.github/workflows/release-binaries.yml b/.github/workflows/release-binaries.yml
new file mode 100644
index 0000000..6e461f7
--- /dev/null
+++ b/.github/workflows/release-binaries.yml
@@ -0,0 +1,89 @@
+# 构建可直接下载的静态二进制并发布 Release。
+#
+# 上游只提供 Docker 镜像(build-edge.yml)，但在裸机上部署时更想直接拿一个二进制，
+# 而不是为了跑 DNS 转发在服务器上装一整套 Docker，也不想为了编译去装 Go 工具链。
+# 这个 workflow 就是补这一块：打 tag 即产出 linux/amd64 与 linux/arm64 的静态二进制，
+# 附带 SHA256 校验和，方便部署脚本直接下载校验后使用。
+name: Release binaries
+
+on:
+  push:
+    tags:
+      - "v*"
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: "手动构建时使用的版本号(如 v0.0.1-test)"
+        required: false
+        default: "manual"
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        goarch: [amd64, arm64]
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-go@v5
+        with:
+          # 跟着 go.mod 里声明的版本走，避免这里写死了版本以后和 go.mod 脱节
+          go-version-file: go.mod
+          cache: true
+
+      - name: 确定版本号
+        id: ver
+        run: |
+          if [ "${GITHUB_REF_TYPE}" = "tag" ]; then
+            echo "version=${GITHUB_REF_NAME}" >> "$GITHUB_OUTPUT"
+          else
+            echo "version=${{ github.event.inputs.tag }}/${GITHUB_SHA::8}" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: 编译
+        env:
+          CGO_ENABLED: "0"
+          GOOS: linux
+          GOARCH: ${{ matrix.goarch }}
+        run: |
+          # -s -w 去掉符号表和调试信息，-trimpath 去掉构建机的绝对路径
+          # (既能显著减小体积，也避免把构建环境的目录结构带进公开产物里)
+          go build -trimpath \
+            -ldflags "-s -w -X main.version=${{ steps.ver.outputs.version }}" \
+            -o "mosproxy-linux-${{ matrix.goarch }}" .
+          sha256sum "mosproxy-linux-${{ matrix.goarch }}" > "mosproxy-linux-${{ matrix.goarch }}.sha256"
+
+      - name: 冒烟测试(仅 amd64，runner 本身就是 amd64)
+        if: matrix.goarch == 'amd64'
+        run: |
+          ./mosproxy-linux-amd64 --version
+          ./mosproxy-linux-amd64 router gen-config /tmp/gen.yaml
+          test -s /tmp/gen.yaml
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: mosproxy-linux-${{ matrix.goarch }}
+          path: |
+            mosproxy-linux-${{ matrix.goarch }}
+            mosproxy-linux-${{ matrix.goarch }}.sha256
+
+  release:
+    # 只有打 tag 才发 Release；手动触发时上面的 artifact 已经够用了
+    if: github.ref_type == 'tag'
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          merge-multiple: true
+          path: dist
+
+      - uses: softprops/action-gh-release@v2
+        with:
+          files: dist/*
+          generate_release_notes: true
diff --git a/FORK-NOTES.zh-CN.md b/FORK-NOTES.zh-CN.md
new file mode 100644
index 0000000..fd6e821
--- /dev/null
+++ b/FORK-NOTES.zh-CN.md
@@ -0,0 +1,100 @@
+# 本 Fork 相对上游的改动说明
+
+上游：[IrineSistiana/mosproxy](https://github.com/IrineSistiana/mosproxy)
+分叉基点：`80afb0117d50963642e49404525589820743620a`
+
+上游是 alpha 阶段项目，没有任何 tag/release，只有 dev 分支。本 fork 的原则是
+**尽量少改**：只修确认的缺陷、补一点自用需要的可观测性，不做架构改动，
+以便随时能跟上游同步、也方便把修复回馈上游。
+
+下面每条都写清楚「改了什么 / 为什么 / 影响面」。
+
+---
+
+## 1. 修复：ECS 前缀没有进入缓存 key（功能缺陷）
+
+**文件**：`app/router/router_utils.go`，函数 `appendCacheKey`
+
+**改动**：
+
+```go
+// 改前
+q.ECS2Upstream.Masked().AppendTo(b)
+// 改后
+b = q.ECS2Upstream.Masked().AppendTo(b)
+```
+
+**为什么**：`AppendTo` 遵循 Go 的 append 惯例——底层数组容量不够时会重新分配，
+并把结果**作为返回值**给出。原代码丢弃了返回值，等于什么都没写进 `b`。
+
+后果有两个：
+
+1. ECS 前缀从未成为缓存 key 的一部分，**所有客户端共享同一条缓存记录**，
+   不区分各自的 /24 子网。启用 ECS 的意义正是让不同网络位置的客户端拿到
+   各自最优的 CDN 节点，这个 bug 会让该能力完全失效，甚至把 A 地区的解析
+   结果返回给 B 地区的客户端。
+2. 紧随其后的 `b[p] = byte(len(b) - p)` 会把长度字节写成"只覆盖类型标记"，
+   key 的结构本身也是错的。
+
+**影响面**：只有在配置里启用了 `ecs` 的部署才会触发；未启用 ECS 时行为不变。
+
+---
+
+## 2. 新增：查询日志输出耗时字段 `elapsed`
+
+**文件**：`app/router/log.go`，函数 `logAccess`
+
+**改动**：在 `query log` 事件里增加一个字段
+
+```go
+e.Dur("elapsed", time.Since(q.Start))
+```
+
+**为什么**：`QueryCtx.Start` 早就在 `NewQueryCtx()` 里被赋值了，但从未出现在任何
+日志里。这导致下游消费日志的程序**无法区分"缓存命中"和"一次慢速递归"**——
+两者的日志除了时间戳完全一样。想做延迟统计，就只能退而求其次用
+`upstream_response_latency_millisecond` 这个按上游聚合的直方图，
+而直方图在采集时就丢弃了单条查询的信息，回答不了"刚才那条查询花了多久"。
+
+加上之后，日志长这样（单位为毫秒，遵循 `zerolog.DurationFieldUnit`，默认即毫秒）：
+
+```json
+{"query":{"qid":567980227,"name":"www.baidu.com","class":1,"type":1},
+ "meta":{"server":"t-udp","remote":"127.0.0.1:47251"},
+ "resp":{"rcode":0,"resp_by":"up-local"},
+ "elapsed":394.32493,"time":1785050824668,"message":"query log"}
+```
+
+同一域名紧接着再查一次（缓存命中）就是 `"elapsed":0.350135`，
+差了三个数量级，一眼就能看出走没走缓存。
+
+**影响面**：只是多一个日志字段。仅在 `log.queries: true` 时才有查询日志；
+解析链路本身不受影响。
+
+---
+
+## 3. 新增：CI 构建可下载的静态二进制
+
+**文件**：`.github/workflows/release-binaries.yml`（新增，不改上游的 `build-edge.yml`）
+
+**为什么**：上游只发布 Docker 镜像。裸机部署时，为了跑一个 DNS 转发器而在服务器上
+装整套 Docker 并不划算，临时装 Go 工具链去编译也很啰嗦（Go SDK 本身就有 50MB+）。
+
+打 tag 即产出 `linux/amd64` 与 `linux/arm64` 的静态二进制（`CGO_ENABLED=0`），
+附 SHA256 校验和，部署脚本可以直接下载校验后使用。
+构建用了 `-trimpath`，产物里不会残留构建机的目录结构。
+
+---
+
+## 与上游同步
+
+改动都很小且彼此独立，同步上游时冲突概率很低：
+
+```bash
+git remote add upstream https://github.com/IrineSistiana/mosproxy.git
+git fetch upstream
+git rebase upstream/dev
+```
+
+第 1 条属于明确的 bug 修复，适合回馈给上游；第 2、3 条是自用增强，
+上游是否需要由维护者决定。
