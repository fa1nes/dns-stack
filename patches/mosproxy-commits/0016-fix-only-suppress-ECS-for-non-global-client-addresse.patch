From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dns-stack <dns-stack@users.noreply.github.com>
Date: Sun, 6 Sep 2026 12:00:00 +0800
Subject: [PATCH 16/16] fix: only suppress ECS for non-global client addresses

When ecs.ip_zone is configured, serverEntryHandler cleared ECS2Upstream for
every address the zone file did not mark, on the assumption that an unmarked
address is a local client. The zone file is built from a geolocation database,
so it covers only the space that database labels; on this deployment 69.85% of
the mainland IPv4 space listed in the routing snapshot carries no mark, and
every client in it silently lost ECS entirely. Upstreams then answered by
resolver location, which is exactly what ECS exists to avoid, and nothing
reported it.

appendCacheKey already handles a missing zone name by sharding on the raw
prefix, so the two halves of the feature disagreed: the cache was prepared for
"no zone, shard by /24" while the handler destroyed the prefix first.

Suppress ECS only when the address genuinely carries no locality an upstream
could act on -- loopback, private, CGNAT, link-local, benchmarking,
documentation and multicast space. LAN and tunnel clients keep the previous
behaviour; public clients now get subnet-aware answers whether or not the zone
file happens to name their network.
---
diff --git a/app/router/ecs.go b/app/router/ecs.go
index ceb1850..bd383d8 100644
--- a/app/router/ecs.go
+++ b/app/router/ecs.go
@@ -108,3 +108,44 @@ func makeEdns0ClientSubnetReqOpt(p netip.Prefix) pool.Buffer {
 	bb[7] = 0
 	return b
 }
+
+// ecsAddrIsGlobal reports whether addr is globally routable unicast space, and
+// therefore carries locality an authoritative server can act on. Addresses
+// outside it (loopback, private, CGNAT, link-local, benchmarking, documentation
+// and multicast ranges) tell an upstream nothing, so forwarding them as a
+// client subnet only leaks topology.
+func ecsAddrIsGlobal(addr netip.Addr) bool {
+	if !addr.IsValid() {
+		return false
+	}
+	addr = addr.Unmap()
+	if addr.IsLoopback() || addr.IsMulticast() || addr.IsUnspecified() ||
+		addr.IsPrivate() || addr.IsLinkLocalUnicast() ||
+		addr.IsLinkLocalMulticast() || addr.IsInterfaceLocalMulticast() {
+		return false
+	}
+	if addr.Is4() {
+		b := addr.As4()
+		switch {
+		case b[0] == 0 || b[0] >= 224:
+			return false
+		case b[0] == 100 && b[1] >= 64 && b[1] <= 127:
+			return false
+		case b[0] == 192 && b[1] == 0 && (b[2] == 0 || b[2] == 2):
+			return false
+		case b[0] == 192 && b[1] == 88 && b[2] == 99:
+			return false
+		case b[0] == 198 && (b[1] == 18 || b[1] == 19):
+			return false
+		case b[0] == 198 && b[1] == 51 && b[2] == 100:
+			return false
+		case b[0] == 203 && b[1] == 0 && b[2] == 113:
+			return false
+		}
+		return true
+	}
+	if addr.Is6() {
+		return addr.As16()[0]&0xe0 == 0x20
+	}
+	return false
+}
diff --git a/app/router/ecs_test.go b/app/router/ecs_test.go
index 26f811e..eaf6a25 100644
--- a/app/router/ecs_test.go
+++ b/app/router/ecs_test.go
@@ -108,3 +108,26 @@ func Test_packECS(t *testing.T) {
 	testFn("1::2/127")
 	testFn("1::2/128")
 }
+
+func Test_ecsAddrIsGlobal(t *testing.T) {
+	global := []string{"1.2.3.4", "202.165.97.53", "116.169.38.235", "2400:3200::1"}
+	local := []string{
+		"0.0.0.0", "10.1.2.3", "100.64.0.1", "127.0.0.1", "169.254.1.1",
+		"172.16.0.1", "192.0.0.1", "192.0.2.1", "192.88.99.1", "192.168.1.1",
+		"198.18.0.1", "198.51.100.1", "203.0.113.1", "224.0.0.1", "255.255.255.255",
+		"::1", "fc00::1", "fe80::1", "ff02::1",
+	}
+	for _, s := range global {
+		if !ecsAddrIsGlobal(netip.MustParseAddr(s)) {
+			t.Errorf("ecsAddrIsGlobal(%s) = false, want true", s)
+		}
+	}
+	for _, s := range local {
+		if ecsAddrIsGlobal(netip.MustParseAddr(s)) {
+			t.Errorf("ecsAddrIsGlobal(%s) = true, want false", s)
+		}
+	}
+	if ecsAddrIsGlobal(netip.Addr{}) {
+		t.Error("ecsAddrIsGlobal(invalid) = true, want false")
+	}
+}
diff --git a/app/router/router_handle.go b/app/router/router_handle.go
index 52560c0..bd173f5 100644
--- a/app/router/router_handle.go
+++ b/app/router/router_handle.go
@@ -31,8 +31,12 @@ func (r *Router) serverEntryHandler(q *QueryCtx) {
 		if r.ecsZone != nil {
 			q.ECSZone, _ = r.ecsZone.Mark(q.ECS2Upstream.Addr())
 
-			// No zone, assume it is local, don not send ecs to upstream
-			if len(q.ECSZone) == 0 {
+			// An address the zone file does not cover is not evidence that the
+			// client is local -- only a non-global address is. Clearing ECS for
+			// every unmarked address silently disables subnet-aware answers for
+			// all public space the zone file happens to miss, and appendCacheKey
+			// already shards by the raw prefix when the zone name is empty.
+			if len(q.ECSZone) == 0 && !ecsAddrIsGlobal(q.ECS2Upstream.Addr()) {
 				q.ECS2Upstream = netip.Prefix{}
 			}
 		}
-- 
