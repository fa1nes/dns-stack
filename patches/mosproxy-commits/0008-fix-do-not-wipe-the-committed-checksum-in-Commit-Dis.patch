From 2bfed9205570a3c366d5e7c5accdab2e07292261 Mon Sep 17 00:00:00 2001
From: fa1nes <302685793+fa1nes@users.noreply.github.com>
Date: Sun, 26 Jul 2026 16:14:15 +0800
Subject: [PATCH 08/11] fix: do not wipe the committed checksum in
 Commit/Discard

Commit stored the new checksum in s.hash and then immediately cleared it; the
intent was to clear the staging hash. Discard cleared the live checksum for the
same reason. After the first real change to a file, the recorded checksum was
therefore always zero, never matched, and every subsequent reload re-read and
re-parsed the file even when its contents were unchanged.

Verified against a running instance: reloading twice with identical content
logged "file loaded" both times instead of "skip loading file, same checksum".
---
 app/router/data_loader.go | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/app/router/data_loader.go b/app/router/data_loader.go
index f109d85..a3276e0 100644
--- a/app/router/data_loader.go
+++ b/app/router/data_loader.go
@@ -86,13 +86,19 @@ func (s *fileLoader[V]) Commit() {
 		s.v.Store(s.staged)
 		s.hash = s.stagedHash
 		s.staged = nil
-		clear(s.hash[:])
+		// Clear the staging hash, not the committed one. Wiping s.hash here threw
+		// away the checksum that was just recorded, so after the first real change
+		// every later reload saw a zero hash, never matched, and re-parsed the file
+		// even when its contents were identical.
+		clear(s.stagedHash[:])
 	}
 }
 
 func (s *fileLoader[V]) Discard() {
 	s.staged = nil
-	clear(s.hash[:])
+	// Same reason as above: discarding a staged value must not invalidate the
+	// checksum of the value that is currently live.
+	clear(s.stagedHash[:])
 }
 
 func (s *fileLoader[V]) V() *V {
-- 
