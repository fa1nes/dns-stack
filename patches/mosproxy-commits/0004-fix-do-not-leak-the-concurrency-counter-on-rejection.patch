From 660e1bb42f2dde2ef1a52ed1a53715c4f1d86150 Mon Sep 17 00:00:00 2001
From: fa1nes <302685793+fa1nes@users.noreply.github.com>
Date: Sun, 26 Jul 2026 15:54:38 +0800
Subject: [PATCH 04/11] fix: do not leak the concurrency counter on rejection

The over-limit branch returned before defer h.concurrent.Add(-1) was
registered, so every rejected query permanently leaked an increment. After
enough bursts the counter stayed above the limit forever and all subsequent
queries were REFUSED until restart, turning a transient spike into a
permanent outage.
---
 app/router/middleware/limit/limit.go | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/app/router/middleware/limit/limit.go b/app/router/middleware/limit/limit.go
index da053f1..cc0ffc4 100644
--- a/app/router/middleware/limit/limit.go
+++ b/app/router/middleware/limit/limit.go
@@ -73,12 +73,18 @@ func (h *Limit) Handle(ctx context.Context, q *router.QueryCtx) {
 
 	if ccLimit := h.args.Concurrent; ccLimit > 0 {
 		cc := h.concurrent.Add(1)
+		// Register the decrement immediately after the increment. It used to sit
+		// after the over-limit check, so a rejected query returned without ever
+		// decrementing -- the counter kept the leaked increment forever. Once
+		// enough bursts leaked past the limit, the counter stayed above ccLimit
+		// permanently and every subsequent query was REFUSED until restart,
+		// turning a transient spike into a permanent self-inflicted outage.
+		defer h.concurrent.Add(-1)
 		if cc > ccLimit {
 			h.rejectedCcTotal.Inc()
 			router.SetEmptyRespMQ(q, dnsmsg.RCodeRefused)
 			return
 		}
-		defer h.concurrent.Add(-1)
 	}
 	h.next.Handle(ctx, q)
 }
