    bash "$DNS_STACK_ROOT/scripts/collect-polluted-ip.sh"
}

action_export() {
    bash "$DNS_STACK_ROOT/migration/export.sh" "$@"
}

action_import() {
    local pkg="${1:-}"
    [[ -z "$pkg" ]] && die "用法: dns-stack import <迁移包路径>"
    bash "$DNS_STACK_ROOT/migration/import.sh" "$pkg"
}

action_verify() {
    local pkg="${1:-}"
    if [[ -z "$pkg" ]]; then
        pkg="$(ls -t /srv/dns-stack/export/*.tar.zst.age /var/backups/dns-stack/*.tar.zst.age 2>/dev/null | head -1 || true)"
        [[ -z "$pkg" ]] && die "用法: dns-stack verify <迁移包路径>(当前没有可自动选取的包)"
        log_info "未指定包，自动选择最新的: $pkg"
    fi
    local rc=0
    bash "$DNS_STACK_ROOT/migration/verify.sh" "$pkg" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        log_err "迁移包校验未通过，请勿用它执行 import(退出码 ${rc})"
    fi
    return "$rc"
}

action_list_packages() {
    echo "导出包(/srv/dns-stack/export):"
    ls -lht /srv/dns-stack/export/*.tar.zst.age 2>/dev/null | awk '{print "  "$5"\t"$9}' || echo "  (无)"
    echo "备份包(/var/backups/dns-stack):"
    ls -lht /var/backups/dns-stack/*.tar.zst* 2>/dev/null | grep -v '\.sha256$' | awk '{print "  "$5"\t"$9}' || echo "  (无)"
}

action_migrate() {
    bash "$DNS_STACK_ROOT/migration/migrate.sh" "$@"
}

action_wg_peer() {
    [[ "$ROLE" == "cn-resolver" ]] || die "wg-peer 在国内机上运行：它把本机注册成 HK 的 peer"
    bash "$DNS_STACK_ROOT/migration/wg-peer.sh" "$@"
}

action_migration_finish() {
    if ! confirm "即将停止本机的 mosproxy/Unbound/面板/分类器服务(不删除任何数据)，确认继续？"; then
        log_warn "已取消"
        return 0
    fi
    systemctl stop mosproxy.service 2>/dev/null || true
    systemctl stop unbound.service 2>/dev/null || true
    systemctl stop dns-stack-panel.service 2>/dev/null || true
    systemctl stop dns-stack-classify.service 2>/dev/null || true
    systemctl disable dns-stack-backup.timer 2>/dev/null || true
    log_ok "旧服务器相关服务已停止(数据仍保留在 /etc/dns-stack /var/lib/dns-stack /var/backups/dns-stack /srv/dns-stack/export)"
}

show_menu() {
    clear 2>/dev/null || true
    echo "========================================"
    echo "        DNS Stack 中文管理工具"
    echo "========================================"
    if [[ "$ROLE" == "cn-resolver" ]]; then
        echo "当前角色：国内 DNS 服务器"
    else
        echo "当前角色：规则构建服务器"
    fi
    if systemctl is-active unbound.service >/dev/null 2>&1; then
        echo "服务状态：运行正常"
    else
        echo "服务状态：${C_YELLOW}部分服务未运行${C_RESET}"
    fi
    echo
    if [[ "$ROLE" == "cn-resolver" ]]; then
        echo " 1. 查看运行状态"
        echo " 2. 执行健康检查"
        echo " 3. 测试域名解析"
        echo " 4. 同步最新 CN 规则"
        echo " 5. 回滚上一版规则"
        echo " 6. 重载 DNS 服务"
        echo " 7. 重启 DNS 服务"
        echo " 8. 查看运行日志"
        echo " 9. 立即备份"
        echo "10. 导出迁移包"
        echo "11. 导入迁移包"
        echo "12. 一键迁移到新服务器"
        echo "13. 检查 TLS 证书"
        echo "14. 续签 TLS 证书"
        echo "15. 查看管理面板信息"
        echo "16. 更新 DNS Stack"
        echo "17. 停止旧服务器服务"
        echo "18. 卸载 DNS Stack"
        echo "19. 采集 GFW 污染 IP"
        echo "20. 投产前完整校验"
        echo "21. 刷新递归分流数据"
        echo " 0. 退出"
    else
        echo " 1. 查看运行状态"
        echo " 2. 执行健康检查"
        echo " 3. 拉取候选域名"
        echo " 4. 立即执行分类"
        echo " 5. 查询指定域名分类"
        echo " 6. 生成 CN/GFW 规则"
        echo " 7. 发布规则到 GitHub"
        echo " 8. 更新中国 IP 数据"
        echo " 9. 查看分类日志"
        echo "10. 立即备份"
        echo "11. 导出迁移包"
        echo "12. 导入迁移包"
        echo "13. 一键迁移到新服务器"
        echo "14. 查看管理面板信息"
        echo "15. 更新 DNS Stack"
        echo "16. 停止旧服务器服务"
        echo "17. 卸载 DNS Stack"
        echo "18. 一键重建规则(不发布)"
        echo " 0. 退出"
    fi
    echo "========================================"
}

interactive_loop() {
    while true; do
        show_menu
        read -r -p "请输入选项: " choice
        if [[ "$ROLE" == "cn-resolver" ]]; then
            case "$choice" in
                1) action_status ;;
                2) action_health ;;
                3) read -r -p "请输入要测试的域名: " d; action_test_domain "$d" ;;
                4) action_sync ;;
                5) action_rollback ;;
                6) action_reload ;;
                7) systemctl restart mosproxy.service && systemctl restart unbound.service && log_ok "已重启" ;;
                8) action_logs mosproxy ;;
                9) action_backup ;;
                10) action_export ;;
                11) read -r -p "请输入迁移包路径: " p; action_import "$p" ;;
                12) read -r -p "请输入目标服务器(如 root@1.2.3.4): " t; action_migrate "$t" ;;
                13) action_cert_check ;;
                14) action_cert_renew ;;
                15) echo "面板地址: http://127.0.0.1:8080 (需通过 SSH 隧道或 WireGuard 访问)" ;;
                16) log_warn "更新功能开发中" ;;
                17) action_migration_finish ;;
                18) log_warn "卸载功能开发中" ;;
                19) action_collect_polluted ;;
                20) action_preflight ;;
                21) action_routing_refresh ;;
                0) echo "再见喵～"; exit 0 ;;
                *) log_warn "无效选项，请重新输入" ;;
            esac
        else
            case "$choice" in
                1) action_status ;;
                2) action_health ;;
                3) action_pull ;;
                4) action_classify ;;
                5) read -r -p "请输入要查询的域名: " d; action_classify "$d" ;;
                6) action_build_rules ;;
                7) action_publish ;;
                8) action_update_cn_ip ;;
                9) action_logs dns-stack-classify ;;
                10) action_backup ;;
                11) action_export ;;
                12) read -r -p "请输入迁移包路径: " p; action_import "$p" ;;
                13) read -r -p "请输入目标服务器(如 root@1.2.3.4): " t; action_migrate "$t" ;;
                14) echo "面板地址: http://127.0.0.1:8080 (需通过 SSH 隧道或 WireGuard 访问)" ;;
                15) log_warn "更新功能开发中" ;;
                16) action_migration_finish ;;
                17) log_warn "卸载功能开发中" ;;
                18) action_rebuild_rules ;;
                0) echo "再见喵～"; exit 0 ;;
                *) log_warn "无效选项，请重新输入" ;;
            esac
        fi
        echo
        read -r -p "按回车键继续..." _
    done
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --yes) YES=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --verbose) VERBOSE=1; set -x; shift ;;
        --limit|--port|--identity|--mode) POSITIONAL+=("$1" "$2"); shift 2 ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]:-}"
[[ "${1:-}" == "" ]] && set --

print_help() {
    cat <<'EOF'
dns-stack 中文管理工具

用法:
  sudo dns-stack                    进入交互菜单

[运行状态]
  sudo dns-stack status             查看运行状态
  sudo dns-stack health             执行健康检查
  sudo dns-stack preflight          投产前完整校验(服务/解析/安全/恢复能力)
  sudo dns-stack panel-password     设置面板访问密码(公网访问必须)
  sudo dns-stack panel-2fa-reset    关闭面板二次认证(验证器丢失时的救砖通道)
  sudo dns-stack doh-path           查看 DoH 接入地址
  sudo dns-stack doh-path --rotate  轮换 DoH 私密路径(所有客户端需同步更新)
  sudo dns-stack test <域名> [子网] 测试域名解析(带子网可看按省调度的真实结果)
  sudo dns-stack diag <域名> [子网] 全链路诊断：解析/ECS/权威走向/四份客户端规则
                                    /ECH/可达性一次列全。"域名打不开"时用这个
  sudo dns-stack logs [服务名]      查看运行日志

[规则管理]
  sudo dns-stack sync               同步 CN/GFW 与两份 IP-CIDR 规则
  sudo dns-stack sync --force       人工确认后允许规则数量大幅缩减
  sudo dns-stack rollback           回滚到上一版规则
  sudo dns-stack pull               拉取候选域名(规则构建角色)
  sudo dns-stack classify [域名]    执行分类 / 查询指定域名
  sudo dns-stack verify-rules       立即复检到期的正式规则(规则构建角色)
  sudo dns-stack build-rules        生成四个公开规则文件
  sudo dns-stack build-rules --force  人工确认后允许规则数量大幅缩减
  sudo dns-stack publish            发布规则到 GitHub
  sudo dns-stack update-cn-ip       更新中国大陆 IP 数据
  sudo dns-stack collect-polluted   采集 GFW DNS 污染 IP
  sudo dns-stack routing-status     查看递归出口分流状态(策略路由/集合/分流链)
  sudo dns-stack routing-refresh    刷新大陆 IP 与墙内域名权威集合
  sudo dns-stack classify-authority 按权威位置重建 CN/foreign 规则(规则构建角色)
  sudo dns-stack rebuild-rules       一键拉取、分类、权威判定并生成规则(不发布)
  sudo dns-stack set-arch-epoch     设定架构基准(此前数据不计入统计)
  sudo dns-stack purge-legacy       删除基准之前的旧架构记录
  sudo dns-stack clear-audit        清空审计记录
  sudo dns-stack vacuum-logs [7d]   清理系统日志(释放磁盘)
  sudo dns-stack clear-domains [天|all] 清理未出现的域名(默认 7 天，all=全清)
  sudo dns-stack migrate-db         备份并迁移现有数据库结构
  sudo dns-stack reset-classifications  废弃旧自动分类并重新检测(保留人工规则/历史)
  sudo dns-stack cold-start-global  清理旧分类并发布全动态冷启动包(规则构建角色)
  sudo dns-stack cold-start-global --reset-all-cidrs  发布域名/IP CIDR 全空重置包
  sudo dns-stack cold-start-cn      接受冷启动包并清空 DNS 缓存(国内角色)
  sudo dns-stack cold-start-cn --reset-all-cidrs  接受全空 CIDR 重置包

[服务控制]
  sudo dns-stack reload             重载 mosproxy 域名表
  sudo dns-stack restart            重启 mosproxy 与 Unbound
  sudo dns-stack cert-check         检查 TLS 证书
  sudo dns-stack cert-renew         立即续签 TLS 证书

[备份与迁移]
  sudo dns-stack backup             立即备份
  sudo dns-stack export [--mode M]  导出迁移包(M: config/state/full)
  sudo dns-stack packages           列出本机所有备份包与导出包
  sudo dns-stack verify [包路径]    只读校验包完整性(不填则校验最新的包)
  sudo dns-stack import <包路径>    导入迁移包(覆盖本机数据，高危)
  sudo dns-stack migrate <目标>     迁移到新服务器(如 root@1.2.3.4)
  sudo dns-stack wg-peer <HK目标>   与 HK 对接 WireGuard 隧道(默认只预演，--apply 才落盘)
  sudo dns-stack migration-finish   迁移完成后停止旧服务器的服务

  sudo dns-stack help               显示本帮助

全局选项: --yes  --dry-run  --verbose
EOF
}

if [[ $# -eq 0 ]]; then
    interactive_loop
    exit 0
fi

cmd="$1"; shift || true

dispatch() {
case "$cmd" in
    status) action_status ;;
    health) action_health ;;
    test) action_test_domain "${1:-}" "${2:-}" ;;
    diag) "$DNS_STACK_ROOT/scripts/diag-domain.sh" "${1:-}" "${2:-}" ;;
    pull) action_pull ;;
    classify) action_classify "${1:-}" ;;
    verify-rules) action_verify_rules "$@" ;;
    build-rules) action_build_rules "$@" ;;
    publish) action_publish ;;
    update-cn-ip) action_update_cn_ip ;;
    sync) action_sync "$@" ;;
    rollback) action_rollback ;;
    collect-polluted) action_collect_polluted ;;
    routing-status) action_routing_status ;;
    purge-legacy) action_purge_legacy ;;
    clear-audit) action_clear_audit ;;
    vacuum-logs) action_vacuum_logs "${1:-}" ;;
    clear-domains) action_clear_domains "${1:-}" ;;
    set-arch-epoch) action_set_arch_epoch "${1:-}" ;;
    routing-refresh) action_routing_refresh ;;
    classify-authority) action_classify_authority "$@" ;;
    rebuild-rules) action_rebuild_rules ;;
    migrate-db) action_migrate_db ;;
    reset-classifications) action_reset_classifications ;;
    cold-start-global) action_cold_start_global "$@" ;;
    cold-start-cn) action_cold_start_cn "$@" ;;
    preflight|check) action_preflight ;;
    panel-password) action_panel_password ;;
    panel-2fa-reset) action_panel_2fa_reset ;;
    doh-path) bash "$DNS_STACK_ROOT/scripts/doh-path.sh" "${@:---print}" ;;
    reload) action_reload ;;
    restart) systemctl restart mosproxy.service && systemctl restart unbound.service && log_ok "已重启" ;;
    cert-check) action_cert_check ;;
    cert-renew) action_cert_renew ;;
    logs) action_logs "${1:-$([ "$ROLE" = "cn-resolver" ] && echo mosproxy || echo dns-stack-classify)}" ;;
    backup) action_backup "$@" ;;
    export) action_export "$@" ;;
    import) action_import "${1:-}" ;;
    verify) action_verify "${1:-}" ;;
    packages|list-packages) action_list_packages ;;
    migrate) action_migrate "$@" ;;
    wg-peer) action_wg_peer "$@" ;;
    migration-finish) action_migration_finish ;;
    help|--help|-h) print_help ;;
    *) log_err "未知命令: ${cmd}"; print_help; exit 1 ;;
esac
}

dispatch "$@" || exit $?
