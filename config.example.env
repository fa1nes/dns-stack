
ROLE=global-builder

PUBLIC_IPV4=
PUBLIC_IPV6=

DOH_PORT=443
DOT_PORT=853
DOH_PATH=/dns-query

UNBOUND_ADDR=127.0.0.1
UNBOUND_PORT=5335

FOREIGN_DOH_1=https://1.1.1.1/dns-query
FOREIGN_DOH_2=https://8.8.8.8/dns-query
FOREIGN_DOH_3=

CN_SERVER_HOST=
CN_SERVER_SSH_USER=
CN_SERVER_SSH_PORT=22
CN_SERVER_WG_IP=

GLOBAL_SERVER_WG_IP=10.100.0.3

FOREIGN_DNS_WG_IP=10.100.0.3
HK_DNS_WG_IP=10.100.0.3

GITHUB_REPOSITORY=yourname/your-rules-repo
GITHUB_BRANCH=main
GITHUB_RAW_BASE=https://raw.githubusercontent.com/yourname/your-rules-repo/main
GITHUB_MIRROR_1=
GITHUB_MIRROR_2=

MOSPROXY_REPO=fa1nes/mosproxy
GIT_COMMIT_NAME=yourname
GIT_COMMIT_EMAIL=you@example.com

RULE_SYNC_INTERVAL=5m
CLASSIFY_INTERVAL=5m
CLASSIFY_CONCURRENCY=20
RULE_RECHECK_MAX_AGE_SEC=21600
RULE_PUBLISH_MAX_STALE_SEC=86400
CANDIDATE_PULL_INTERVAL=5m
DIRECT4_FILE=/var/lib/dns-stack/chnroute/direct4.txt

PANEL_LISTEN=127.0.0.1:8080
PANEL_PUBLIC=false
PANEL_CORS_ORIGINS=
PANEL_COOKIE_SAMESITE=strict

BACKUP_RETENTION_DAILY=3
BACKUP_RETENTION_WEEKLY=0
BACKUP_ZSTD_LEVEL=6
BACKUP_ZSTD_THREADS=2
RULE_BUNDLE_HISTORY_KEEP=0

GEOIP_ENABLE_CITY=1
GEOIP_ASN_URL=https://cdn.jsdelivr.net/gh/P3TERX/GeoLite.mmdb@download/GeoLite2-ASN.mmdb
GEOIP_CITY_URL=https://raw.githubusercontent.com/P3TERX/GeoLite.mmdb/download/GeoLite2-City.mmdb

GEOIP_RELEASE_REPO=
GEO_CROSS_AGREEMENT=2
GEO_CROSS_MAX_AGE_SEC=172800
